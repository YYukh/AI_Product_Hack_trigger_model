# Скопируйте в .env и при необходимости отредактируйте: cp .env.example .env
#
# Домен и TLS настраиваются НЕ здесь, а в файле Caddyfile (замена строки ":80"
# на имя домена). Локально ничего менять не нужно.

# Источник сигналов. Пусто → data/signals.json. Иначе бэкенд ходит по HTTP,
# при ошибке/таймауте откатывается на файл (видно в /api/health).
# Оверлей docker-compose.ml.yml сам проставляет ML_URL/RATES_URL/MOMENT_URL —
# здесь трогать не нужно.
ML_URL=
ML_TIMEOUT_S=2

# --- ML-конвейер (оверлей docker-compose.ml.yml, профиль ml) ---
# Глубина walk-forward replay движков. Полный прогон (как в ноутбуке ML-команды)
# — с 2020-01-01, первый старт 15–30 мин; сузить до 2024-01-01 → ~3–7 мин.
ML_REPLAY_FROM=2020-01-01
# Источник котировок парсера: auto (ЦБ, при сбое снапшот) | live | fallback.
CBR_PREFER=auto
# Пересчитать прогрев принудительно (иначе ml-warmup видит ready.json и выходит).
ML_WARMUP_FORCE=false

# Порог состояния «момент изменился», базисные пункты.
DRIFT_THRESHOLD_BP=20

# Срок жизни пуша в минутах (по умолчанию 24 ч).
PUSH_TTL_MINUTES=1440

# Коммуникационная политика.
PUSH_BUDGET_MONTH=8
PUSH_COOLDOWN_DAYS=3

# Расширенный уровень: резервирование. false → базовый путь остаётся рабочим.
FEATURE_RESERVE=true
RESERVE_TTL_DAYS=7
RESERVE_PERCENTILE=25
RESERVE_WINDOW_DAYS=30

# Опциональный сюжет: право вето получателя (лимит фото-идентификации).
FEATURE_RECIPIENT_LIMIT=true
